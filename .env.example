# Copy this file to .env and fill in real values before running docker compose.
# docker compose automatically loads .env from the project root.

# ── JWT ──────────────────────────────────────────────────────────────────────
# Change this to a long random string in any non-local environment.
JWT_SECRET_KEY=dev-secret-change-in-prod

# ── MongoDB ──────────────────────────────────────────────────────────────────
# When running via docker compose, leave as-is (uses the mongodb container).
MONGODB_URL=mongodb://lab2admin:lab2secret@mongodb:27017/?authSource=admin
MONGODB_DB_NAME=yelp_lab2
MONGO_INITDB_ROOT_USERNAME=lab2admin
MONGO_INITDB_ROOT_PASSWORD=lab2secret

# ── Kafka ────────────────────────────────────────────────────────────────────
# When running via docker compose, leave as-is (uses the kafka container).
KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# ── Session ──────────────────────────────────────────────────────────────────
SESSION_TTL_HOURS=24

# ── AI Assistant (Gemini & Tavily) ───────────────────────────────────────────
# Get your Gemini API key from https://aistudio.google.com/
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Get your Tavily API key from https://tavily.com/
TAVILY_API_KEY=
TAVILY_ENABLED=true
